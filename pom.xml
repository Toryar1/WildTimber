<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.wildtimber</groupId>
    <artifactId>WildTimber</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>WildTimber</name>
    <description>Plugin d'abattage d'arbres massif mais contrôle pour serveurs Paper/Purpur.</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <!-- Valeurs par défaut (overridées par les profils) -->
        <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
        <jar.finalName>WildTimber-paper-${project.version}</jar.finalName>
    </properties>

    <repositories>
        <!-- PaperMC Repository -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- ExtendedClip Repository (PlaceholderAPI) -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (version contrôlée par le profil actif) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- PlaceholderAPI -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Profil Paper 1.19.4
            Commande : mvn clean package -P paper-1.19
        -->
        <profile>
            <id>paper-1.19</id>
            <properties>
                <paper.api.version>1.19.4-R0.1-SNAPSHOT</paper.api.version>
                <jar.finalName>WildTimber-paper-1.19-${project.version}</jar.finalName>
            </properties>
        </profile>

        <!--
            Profil Paper 1.20
            Commande : mvn clean package -P paper-1.20
        -->
        <profile>
            <id>paper-1.20</id>
            <properties>
                <paper.api.version>1.20-R0.1-SNAPSHOT</paper.api.version>
                <jar.finalName>WildTimber-paper-1.20-${project.version}</jar.finalName>
            </properties>
        </profile>

        <!--
            Profil Paper 1.20.6
            Commande : mvn clean package -P paper-1.20.6
        -->
        <profile>
            <id>paper-1.20.6</id>
            <properties>
                <paper.api.version>1.20.6-R0.1-SNAPSHOT</paper.api.version>
                <jar.finalName>WildTimber-paper-1.20.6-${project.version}</jar.finalName>
            </properties>
        </profile>

        <!--
            Profil Paper 1.21.11 (défaut)
            Commande : mvn clean package -P paper-1.21
        -->
        <profile>
            <id>paper-1.21</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
                <jar.finalName>WildTimber-paper-1.21-${project.version}</jar.finalName>
            </properties>
        </profile>

        <!--
            Profil Purpur / Paper 26.1
            Commande : mvn clean package -P paper-26.1
        -->
        <profile>
            <id>paper-26.1</id>
            <properties>
                <paper.api.version>26.1.2.build.72-stable</paper.api.version>
                <jar.finalName>WildTimber-paper-26.1-${project.version}</jar.finalName>
            </properties>
        </profile>

        <!--
            Profil Paper 26.2 (serveur de test actuel)
            Commande : mvn clean package -P paper-26.2
        -->
        <profile>
            <id>paper-26.2</id>
            <properties>
                <paper.api.version>26.2.build.60-beta</paper.api.version>
                <jar.finalName>WildTimber-paper-26.2-${project.version}</jar.finalName>
            </properties>
        </profile>
    </profiles>

    <build>
        <!-- Nom du JAR produit, différent selon le profil actif -->
        <finalName>${jar.finalName}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
